{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ESNext.Disposable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@ylcnfrht/ioc": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ],
  "exclude": [
    "examples/*express*",
    "examples/js"
  ]
}